# Database
DATABASE_URL=sqlite:///./art_ai.db

# Security — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Your Render backend URL (no trailing slash)
API_BASE_URL=https://your-backend.onrender.com

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Optional: extra allowed origins, comma-separated (e.g. Vercel preview URLs)
# EXTRA_ORIGINS=https://your-app-git-branch.vercel.app
